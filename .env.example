# Copy to .env.local and add the connection string from the Wallora website Neon project.
# Keep this file private; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Existing admin/session authentication variables used by the website.
ADMIN_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret
